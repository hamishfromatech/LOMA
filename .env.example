# Copy to .env and edit. Every value is optional; the defaults are tuned
# for a 128k context window at roughly 3 GB of RAM.

# --- Ollama ---------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
LOMA_LLM_MODEL=qwen3.5:0.8b
LOMA_TTS_MODEL=phonon
LOMA_TTS_VOICE=default
LOMA_KEEP_ALIVE=30m

# --- Routing --------------------------------------------------------------
# Control phrases (stop / reset / repeat / exit) are a deterministic lexicon:
# no model, no RAM, no latency. Leave this on.
LOMA_CONTROL_ENABLED=true

# --- MCP tools ------------------------------------------------------------
# Needle 3 (35 MB) picks the tool and fills the arguments.
LOMA_MCP_ENABLED=true
LOMA_MCP_CONFIG=mcp.json
# Below this confidence Needle's call is ignored and the LLM answers.
# Tune per toolset: see `loma tools --probe`.
LOMA_TOOL_MIN_CONFIDENCE=0.50
# The router only sees this many tools; raise it if you have a big server.
LOMA_TOOL_MAX_TOOLS=40

# --- Speech to text -------------------------------------------------------
LOMA_STT_MODEL=tiny
LOMA_STT_DEVICE=cpu
LOMA_STT_COMPUTE_TYPE=int8
LOMA_STT_LANGUAGE=
# Cache whisper weights inside the repo so the pipeline works offline.
LOMA_MODELS_DIR=models

# --- Context window -------------------------------------------------------
# 0 = choose from physical RAM: 131072 on <=8 GB, 262144 on >8 GB.
LOMA_NUM_CTX=0
LOMA_MAX_TOKENS=256
LOMA_TEMPERATURE=0.4
LOMA_HISTORY_TURNS=6

# --- Auto compaction ------------------------------------------------------
LOMA_COMPACT_ENABLED=true
# Compact at 60% of the window ...
LOMA_COMPACT_AT=0.60
# ... or at this many live tokens, whichever comes first. This is what keeps
# the KV cache (and therefore RAM) bounded on a 128k window.
LOMA_COMPACT_TARGET_TOKENS=8192
LOMA_COMPACT_KEEP_TURNS=2
LOMA_COMPACT_MAX_TOKENS=320

# --- Audio / VAD ----------------------------------------------------------
LOMA_SAMPLE_RATE=16000
LOMA_SILENCE_DB=-45
LOMA_SILENCE_MS=800
LOMA_MAX_UTTERANCE_S=15
LOMA_MIC_DEVICE=

# --- Safety ---------------------------------------------------------------
# Used by `loma bench` and the runtime memory guard.
LOMA_MEMORY_BUDGET_MB=3072
