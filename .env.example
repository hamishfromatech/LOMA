# Copy to .env and edit. Every value is optional; the defaults are tuned
# for a 128k context window at roughly 3 GB of RAM.

# --- Ollama ---------------------------------------------------------------
OLLAMA_HOST=http://localhost:11434
LOMA_LLM_MODEL=lfm3:latest
# Images are answered by a separate model. With dynamic loading on, the text
# model is unloaded first, so only one chat model sits in memory.
LOMA_VLM_MODEL=lfm3-vl:2b
LOMA_DYNAMIC_MODELS=true
LOMA_TTS_MODEL=phonon
LOMA_TTS_VOICE=default
# How long the active chat model stays loaded after a turn. 0 unloads it
# immediately; Ollama reloads it (about a second) on the next turn.
LOMA_KEEP_ALIVE=30m

# --- Routing --------------------------------------------------------------
# Control phrases (stop / reset / repeat / exit) are a deterministic lexicon:
# no model, no RAM, no latency. Leave this on.
LOMA_CONTROL_ENABLED=true

# --- MCP tools ------------------------------------------------------------
# Needle 3 (35 MB) triages; the language model calls the tools with Ollama's
# native tool calling.
LOMA_MCP_ENABLED=true
LOMA_MCP_CONFIG=mcp.json
# Triage gate: below this, the turn is answered with no toolset at all.
# Low on purpose — it is a recall filter, not the final decision.
LOMA_TRIAGE_ENABLED=true
LOMA_TRIAGE_MIN_CONFIDENCE=0.0
# Off by default: offer every tool once triage clears. Turn it on for a large
# toolset, where a confident triage candidate shortlist saves prompt tokens.
LOMA_TOOL_SHORTLIST=false
# The shortlist/diagnostic confidence floor.
LOMA_TOOL_MIN_CONFIDENCE=0.50
# Native tool-call rounds per turn before the model is asked to answer.
LOMA_TOOL_ROUNDS=3
# The router only sees this many tools; raise it if you have a big server.
LOMA_TOOL_MAX_TOOLS=40

# --- Speech to text -------------------------------------------------------
LOMA_STT_MODEL=tiny
LOMA_STT_DEVICE=cpu
LOMA_STT_COMPUTE_TYPE=int8
LOMA_STT_LANGUAGE=
# Cache whisper weights inside the repo so the pipeline works offline.
LOMA_MODELS_DIR=models

# --- Context window -------------------------------------------------------
# 0 = choose from physical RAM: 131072 on <=8 GB, 262144 on >8 GB.
LOMA_NUM_CTX=0
LOMA_MAX_TOKENS=256
LOMA_TEMPERATURE=0.4
LOMA_HISTORY_TURNS=6

# --- Auto compaction ------------------------------------------------------
LOMA_COMPACT_ENABLED=true
# Compact at 60% of the window ...
LOMA_COMPACT_AT=0.60
# ... or at this many live tokens, whichever comes first. This is what keeps
# the KV cache (and therefore RAM) bounded on a 128k window.
LOMA_COMPACT_TARGET_TOKENS=8192
LOMA_COMPACT_KEEP_TURNS=2
LOMA_COMPACT_MAX_TOKENS=320

# --- Audio / VAD ----------------------------------------------------------
LOMA_SAMPLE_RATE=16000
LOMA_SILENCE_DB=-45
LOMA_SILENCE_MS=800
LOMA_MAX_UTTERANCE_S=15
LOMA_MIC_DEVICE=

# --- Safety ---------------------------------------------------------------
# Used by `loma bench` and the runtime memory guard.
LOMA_MEMORY_BUDGET_MB=3072
